{
	"mcpServers": {
		"convex": {
			"command": "npx",
			"args": ["-y", "convex@latest", "mcp", "start"]
		},
		"context7-mcp": {
			"command": "npx",
			"args": ["-y", "@upstash/context7-mcp"]
		},
		"playwright": {
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@latest",
				"--browser",
				"chromium",
				"--headless"
			]
		}
	}
}
