#!/usr/bin/env python3
import argparse
import json
import logging
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

logger = logging.getLogger("git-ac")

OLLAMA_HOST = os.environ.get("OLLAMA_HOST", "http://localhost:11434")
DEFAULT_MODEL_OLLAMA = "deepseek-v4.1-flash:cloud"
DEFAULT_MODEL = "gpt-6-luna"

PROMPT_TEMPLATE = """Generate a git commit message for these changes.

Infer the commit message conventions from these recent commits, including
subject format, prefixes, capitalization, mood, body usage, and line length:

{history}

Follow those conventions and output only the commit message, without Markdown
code blocks, explanations, commentary, or model attribution.

Write a commit message for this Git diff:

{diff}"""


def detect_provider(model):
    if model.startswith(("openai/", "codex/", "gpt-", "o1", "o3", "o4")):
        return "fx"
    return "ollama"


def strip_prefix(model):
    if model.startswith(("openai/", "codex/", "ollama/")):
        return model.split("/", 1)[1]
    return model


def http_request(url, data=None, headers=None):
    body = json.dumps(data).encode() if data else None
    hdrs = headers or {}
    if body and "Content-Type" not in hdrs:
        hdrs["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=body, headers=hdrs)
    with urllib.request.urlopen(req) as resp:
        return json.loads(resp.read().decode())


def ollama_request(path, data=None):
    url = f"{OLLAMA_HOST.rstrip('/')}{path}"
    return http_request(url, data)


def fx_message(model, prompt):
    binary = shutil.which("fx") or os.path.expanduser("~/.local/bin/fx")
    command = [
        binary,
        "--context-limit",
        "project_instructions_total_bytes=0",
        "--context-limit",
        "skill_catalog_bytes=0",
        "ask",
        "--model",
        strip_prefix(model),
        "--effort",
        "low",
        "--json",
        "--no-save",
        "--no-color",
        "--system",
        "Generate only a git commit message from the supplied diff and history; do not use tools.",
    ]
    env = {
        **os.environ,
        "FX_PROVIDER": "codex",
        "FX_MAX_AGENT_STEPS": "1",
        "FX_PERMISSION_MODE": "ask",
        "FX_AUTO_UPGRADE": "0",
        "FX_SOUND": "off",
    }
    with tempfile.TemporaryDirectory(prefix="git-ac-") as cwd:
        result = subprocess.run(
            command,
            input=prompt,
            capture_output=True,
            text=True,
            env=env,
            cwd=cwd,
            timeout=60,
            check=True,
        )
    response = json.loads(result.stdout)
    content = response.get("final_output") if isinstance(response, dict) else None
    if (
        not isinstance(content, str)
        or not content.strip()
        or response.get("exit_code") != 0
        or response.get("tool_calls")
    ):
        raise ValueError("fx did not return a completed text-only response")
    return content.strip()


def model_exists(model):
    tags = ollama_request("/api/tags")
    return any(m["name"] == model for m in tags.get("models", []))


def pull_model(model):
    logger.info("Model %s not found locally, pulling...", model)
    subprocess.run(["ollama", "pull", model], check=True)


def build_prompt(diff_text, history):
    return PROMPT_TEMPLATE.format(diff=diff_text, history=history)


def stage_paths(paths):
    if paths:
        subprocess.run(["git", "add", "--", *paths], check=True)


def commit_command(message_file, paths):
    command = ["git", "commit", "--cleanup=strip", "-F", message_file]
    if paths:
        command.extend(["--only", "--", *paths])
    return command


def retry_command(args, model):
    command = ["git", "ac", "--model", model]
    if args.no_edit:
        command.append("-y")
    if args.dry_run:
        command.append("-n")
    if args.paths:
        command.extend(["--", *args.paths])
    return shlex.join(command)


def report_generation_error(error, args, requested_model):
    """Explain expected failures without printing provider bodies or credentials."""
    provider = (
        "fx (Codex subscription)" if detect_provider(args.model) == "fx" else "Ollama"
    )
    color = (
        sys.stderr.isatty()
        and "NO_COLOR" not in os.environ
        and os.environ.get("TERM") != "dumb"
    )

    def paint(text, code):
        return f"\033[{code}m{text}\033[0m" if color else text

    status = error.code if isinstance(error, urllib.error.HTTPError) else None
    context = f"{provider} / {args.model}" + (f" / HTTP {status}" if status else "")
    steps = []
    if provider != "Ollama":
        reason = "fx could not complete subscription-backed generation."
        steps.append(
            "Check fx is installed and sign in with your ChatGPT subscription: fx login codex"
        )
        steps.append(
            f"Retry with Ollama:\n      {retry_command(args, DEFAULT_MODEL_OLLAMA)}"
        )
    elif status == 429:
        reason = "The service rejected the request: rate limit or quota exhausted."
        delay = error.headers.get("Retry-After", "") if error.headers else ""
        wait = (
            f"Wait at least {delay} seconds"
            if delay.isdecimal()
            else "Wait for the rate limit or quota to reset"
        )
        steps.append(f"{wait}, then retry:\n      {retry_command(args, args.model)}")
    elif status in (401, 403):
        reason = "Authentication is missing or was rejected."
        steps.append("Sign in to Ollama on the server running the model: ollama signin")
    elif status is None and isinstance(error, (urllib.error.URLError, TimeoutError)):
        reason = "Could not reach the model service."
        steps.append("Check OLLAMA_HOST and that Ollama is running (ollama serve).")
    elif isinstance(error, subprocess.CalledProcessError):
        reason = "Ollama could not download the selected model."
        steps.append("Check the model name and Ollama connection before retrying.")
    else:
        reason = "The model service rejected the request."
        steps.append("Check the model name and service availability before retrying.")
    if provider == "Ollama":
        steps.append(
            f"Choose an installed local model from `ollama list` (replace MODEL):\n      {retry_command(args, 'MODEL')}"
        )
    manual = ["git", "commit"]
    if args.paths:
        manual.extend(["--only", "--", *args.paths])
    steps.append(f"Or commit without AI:\n      {shlex.join(manual)}")

    print(
        paint("git-ac: Could not generate a commit message.", "1;31"), file=sys.stderr
    )
    print(f"  {context}\n  {reason}", file=sys.stderr)
    if requested_model != args.model:
        print(
            f"\n  Requested {requested_model}; used Ollama because fx generation failed.",
            file=sys.stderr,
        )
        print(
            "  Check your subscription login with: fx login codex",
            file=sys.stderr,
        )
    print("\n  No commit was created; your changes remain staged.", file=sys.stderr)
    print("\n  " + paint("Next steps", "1;36"), file=sys.stderr)
    for step in steps:
        print(f"    • {step}", file=sys.stderr)


def generate_message(model, diff_text, history):
    provider = detect_provider(model)
    logger.debug("Using provider=%s model=%s", provider, model)
    prompt = build_prompt(diff_text, history)
    start = time.perf_counter()
    if provider == "fx":
        content = fx_message(model, prompt)
    else:
        model = strip_prefix(model)
        if not model_exists(model):
            pull_model(model)
        payload = {
            "model": model,
            "stream": False,
            "reasoning_effort": "none",
            "messages": [{"role": "user", "content": prompt}],
        }
        resp = ollama_request("/v1/chat/completions", payload)
        content = resp["choices"][0]["message"]["content"]
        if not isinstance(content, str) or not content.strip():
            raise ValueError("Ollama returned an empty message")
    elapsed = time.perf_counter() - start
    logger.debug("Generated message in %.2fs (%d chars)", elapsed, len(content))
    return content, elapsed


def main():
    parser = argparse.ArgumentParser(
        prog="git-ac",
        description="Generate a commit message using fx (Codex subscription), with Ollama fallback.",
    )
    parser.add_argument(
        "-y", "--no-edit", action="store_true", help="Commit directly without editing"
    )
    parser.add_argument(
        "-n", "--dry-run", action="store_true", help="Print message, don't commit"
    )
    parser.add_argument(
        "-m",
        "--model",
        help=f"Model (default: {DEFAULT_MODEL}; fallback: {DEFAULT_MODEL_OLLAMA}); explicit models do not fall back",
    )
    parser.add_argument(
        "-v", "--verbose", action="store_true", help="Show timing and quality metrics"
    )
    parser.add_argument(
        "-d", "--debug", action="store_true", help="Enable debug logging"
    )
    parser.add_argument("paths", nargs="*", help="Paths to stage before committing")
    args = parser.parse_args()

    log_level = (
        logging.DEBUG
        if args.debug
        else logging.INFO
        if args.verbose
        else logging.WARNING
    )
    logging.basicConfig(level=log_level, format="%(name)s: %(message)s")

    allow_fallback = args.model is None
    args.model = args.model or DEFAULT_MODEL
    requested_model = args.model

    stage_paths(args.paths)

    if (
        subprocess.run(["git", "diff", "--staged", "--quiet"], check=False).returncode
        == 0
    ):
        logger.error("No staged changes")
        sys.exit(1)

    diff_text = subprocess.run(
        ["git", "diff", "--staged"], capture_output=True, text=True, check=False
    ).stdout
    history = subprocess.run(
        ["git", "log", "-10", "--format=%B%n---"],
        capture_output=True,
        text=True,
        check=False,
    ).stdout
    logger.debug("Diff size: %d bytes", len(diff_text))

    provider = detect_provider(args.model)
    try:
        try:
            message, elapsed = generate_message(args.model, diff_text, history)
        except (OSError, subprocess.SubprocessError, ValueError):
            if not allow_fallback:
                raise
            logger.warning(
                "fx generation failed; falling back to Ollama / %s",
                DEFAULT_MODEL_OLLAMA,
            )
            args.model = DEFAULT_MODEL_OLLAMA
            provider = "ollama"
            message, elapsed = generate_message(args.model, diff_text, history)
    except (
        OSError,
        subprocess.SubprocessError,
        ValueError,
    ) as error:
        report_generation_error(error, args, requested_model)
        return 1

    if args.dry_run:
        print(message)
        if args.verbose:
            subject = message.split("\n", 1)[0]
            body_lines = message.split("\n")[2:] if "\n\n" in message else []
            logger.info("")
            logger.info("---")
            logger.info("Provider: %s", provider)
            logger.info("Model: %s", args.model)
            logger.info("Generation time: %.2fs", elapsed)
            logger.info("Subject line length: %d chars", len(subject))
            logger.info("Body lines: %d", len(body_lines))
        sys.exit(0)

    tmpdir = tempfile.mkdtemp()
    try:
        tmpfile = os.path.join(tmpdir, "COMMIT_EDITMSG")
        with open(tmpfile, "w") as f:
            f.write(f"{message.rstrip()}\n\n# Model: {args.model}\n")

        if not args.no_edit:
            editor = os.environ.get("GIT_EDITOR") or os.environ.get("EDITOR", "vi")
            subprocess.run(f"{editor} {tmpfile}", shell=True, check=True)

        if os.path.getsize(tmpfile) == 0:
            logger.error("Empty commit message, aborting")
            sys.exit(1)

        subprocess.run(commit_command(tmpfile, args.paths), check=True)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)

    if args.verbose:
        subject = message.split("\n", 1)[0]
        logger.info("")
        logger.info("---")
        logger.info("Provider: %s", provider)
        logger.info("Model: %s", args.model)
        logger.info("Generation time: %.2fs", elapsed)
        logger.info("Subject: %s", subject)
        logger.info("Subject length: %d chars", len(subject))


if __name__ == "__main__":
    sys.exit(main())
