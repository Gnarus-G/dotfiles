#!/bin/sh
# The work laptop's /etc/ld.so.preload injects libAppProtection.so, which hooks
# dlsym. That breaks gtk4-layer-shell's RTLD_NEXT lookup of libwayland, so
# ghostty recurses forever in wl_proxy_marshal_array_flags and segfaults.
# Preloading gtk4-layer-shell puts it ahead of the hook. Delete this file once
# IT fixes AppProtection.
LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so exec /usr/bin/ghostty "$@"
