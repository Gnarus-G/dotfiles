#!/usr/bin/env python3

import argparse
import math
import os
import re
import subprocess
import tempfile
from pathlib import Path


PARAMS = (
    "output-cap",
    "smooth",
    "input-dpi",
    "offset-linear",
    "accel",
    "sens-mult",
    "yx-ratio",
    "decay-rate",
    "limit",
    "gamma",
    "sync-speed",
    "angle-rotation",
    "motivity",
)
MODES = {
    "Linear Acceleration": "linear",
    "Natural (w/ Gain)": "natural",
    "Synchronous": "synchronous",
    "No Acceleration": "no-accel",
}
NAME_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")


def run_maccel(*args: str) -> str:
    binary = os.environ.get("MACCEL_BIN", "maccel")
    return subprocess.run(
        (binary, *args), check=True, text=True, capture_output=True
    ).stdout.strip()


def profile_dir() -> Path:
    configured = os.environ.get("MACCEL_PROFILE_DIR")
    if configured:
        return Path(configured).expanduser()
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "maccel" / "profiles"


def profile_path(name: str) -> Path:
    if not NAME_PATTERN.fullmatch(name):
        raise ValueError(f"invalid profile name: {name}")
    return profile_dir() / name


def validate_number(value: str) -> None:
    try:
        valid = math.isfinite(float(value))
    except ValueError:
        valid = False
    if not valid:
        raise ValueError(f"invalid numeric value: {value}")


def backup(name: str) -> None:
    path = profile_path(name)
    mode_output = run_maccel("get", "mode").splitlines()[0]
    try:
        mode = MODES[mode_output]
    except KeyError as error:
        raise ValueError(f"unknown maccel mode: {mode_output}") from error

    values = []
    for param in PARAMS:
        value = run_maccel("get", "param", param)
        validate_number(value)
        values.append((param, value))

    path.parent.mkdir(parents=True, exist_ok=True)
    content = "\n".join((f"mode {mode}", *(f"{key} {value}" for key, value in values))) + "\n"
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as file:
        try:
            file.write(content)
            temp_path = Path(file.name)
        except Exception:
            Path(file.name).unlink(missing_ok=True)
            raise
    temp_path.replace(path)
    print(f"Backed up {path}")


def read_profile(path: Path) -> tuple[str, dict[str, str]]:
    entries: dict[str, str] = {}
    for line_number, line in enumerate(path.read_text().splitlines(), 1):
        parts = line.split()
        if len(parts) != 2 or parts[0] in entries:
            raise ValueError(f"invalid profile line {line_number}: {line}")
        entries[parts[0]] = parts[1]

    mode = entries.pop("mode", None)
    if mode not in MODES.values() or set(entries) != set(PARAMS):
        raise ValueError(f"invalid profile: {path}")
    for value in entries.values():
        validate_number(value)
    return mode, entries


def restore(name: str) -> None:
    path = profile_path(name)
    if not path.is_file():
        raise FileNotFoundError(f"profile not found: {path}")
    mode, values = read_profile(path)
    for param in PARAMS:
        run_maccel("set", "param", param, "--", values[param])
    run_maccel("set", "mode", mode)
    print(f"Restored {path}")


def list_profiles() -> None:
    directory = profile_dir()
    if directory.is_dir():
        for path in sorted(directory.iterdir()):
            if path.is_file():
                print(path.name)


def main() -> None:
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    for command in ("backup", "restore"):
        subparser = subparsers.add_parser(command)
        subparser.add_argument("name")
    subparsers.add_parser("list")
    args = parser.parse_args()

    try:
        if args.command == "backup":
            backup(args.name)
        elif args.command == "restore":
            restore(args.name)
        else:
            list_profiles()
    except (FileNotFoundError, OSError, subprocess.CalledProcessError, ValueError) as error:
        parser.exit(1, f"maccel-profile: {error}\n")


if __name__ == "__main__":
    main()
