#!/usr/bin/env bash
set -euo pipefail

# Optional workstation installers.
# Pick one or more entries with fzf multi-select (Tab), then press Enter.

section() {
  printf '\n\033[1;35m==> %s\033[0m\n' "$1"
}

pacman_install() {
  sudo pacman -S --needed "$@"
}

install_mouse_driver() {
  section "Mouse acceleration driver"
  pacman_install base-devel linux-lts-headers linux-zen-headers
  curl -fsSL https://www.maccel.org/install.sh | sudo sh
}

install_virt_manager() {
  section "VirtManager"
  pacman_install qemu-desktop libvirt edk2-ovmf virt-manager dnsmasq
  sudo usermod -aG libvirt,kvm,input "$USER"
  sudo virsh net-autostart default || true
  sudo virsh net-start default || true
  sudo systemctl enable libvirtd.service --now
  sudo systemctl enable virtlogd.socket --now
  echo "Log out and back in for group changes to apply."
}

install_stable_diffusion_webui() {
  section "Stable Diffusion Web UI"
  mkdir -p "$HOME/d"
  if [[ ! -d $HOME/d/stable-diffusion-webui ]]; then
    git clone https://github.com/AUTOMATIC1111/stable-diffusion-webui "$HOME/d/stable-diffusion-webui"
  fi
  cd "$HOME/d/stable-diffusion-webui"
  rm -rf venv
  sed 's/#\s*python_cmd=".*"/python_cmd="python3.11"/' -i webui-user.sh
  command -v paru >/dev/null 2>&1 || { echo "paru is required for python311" >&2; exit 1; }
  paru -S --needed python311
  echo "Run ./webui.sh when you want to start it."
  echo "Usage guide: https://stable-diffusion-art.com/models/"
}

install_stable_diffusion_forge() {
  section "Stable Diffusion Forge remote/branch"
  cd "$HOME/d/stable-diffusion-webui"
  git remote get-url forge >/dev/null 2>&1 || git remote add forge https://github.com/lllyasviel/stable-diffusion-webui-forge
  git fetch forge
  git branch --track lllyasviel/main forge/main 2>/dev/null || true
  git checkout lllyasviel/main
  git pull
}

open_opencode_browser_docs() {
  section "OpenCode browser plugin"
  echo "Docs live in this repo: .config/opencode/browser-plugin-setup.md"
  echo "They cover the dedicated Chrome profile, plugin installer, unpacked extension, and broker verification."
}

choices=$(
  cat <<'CHOICES' | fzf --multi --with-nth=1 --delimiter=$'\t' --prompt='optional tools > '
mouse-driver	maccel mouse acceleration driver and kernel headers
virt-manager	QEMU/libvirt desktop virtualization
stable-diffusion-webui	AUTOMATIC1111 Web UI under ~/d
stable-diffusion-forge	Forge branch for an existing Stable Diffusion Web UI checkout
opencode-browser-docs	Print where the browser plugin setup guide lives
CHOICES
)

[[ -n ${choices:-} ]] || exit 0

while IFS=$'\t' read -r name _; do
  case "$name" in
    mouse-driver) install_mouse_driver ;;
    virt-manager) install_virt_manager ;;
    stable-diffusion-webui) install_stable_diffusion_webui ;;
    stable-diffusion-forge) install_stable_diffusion_forge ;;
    opencode-browser-docs) open_opencode_browser_docs ;;
  esac
done <<< "$choices"
