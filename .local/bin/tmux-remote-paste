#!/usr/bin/env bash
# Forward Ctrl-V normally, except for images pasted into compute1 over SSH.
set -u

pane=$1
pid=$(tmux display-message -p -t "$pane" '#{pane_pid}') || exit 1
command=$(tmux display-message -p -t "$pane" '#{pane_current_command}') || exit 1

forward_key() { tmux send-keys -t "$pane" C-v; }

if [[ $command != ssh ]]; then
  forward_key
  exit
fi

host=
while read -r ssh_pid; do
  case $(ps -o args= -p "$ssh_pid") in
    *moon-oma-compute1.grid.ransky.io*) host=moon-oma-compute1.grid.ransky.io ;;
    *' compute1'*) host=compute1 ;;
  esac
done < <(pgrep -P "$pid" -x ssh || true)

# Older tmux servers may not have inherited the current Wayland session.
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
  for socket in "$XDG_RUNTIME_DIR"/wayland-*; do
    if [[ -S $socket ]]; then
      export WAYLAND_DISPLAY=${socket##*/}
      break
    fi
  done
fi

if [[ -z $host ]] || ! wl-paste --list-types 2>/dev/null | grep -qx 'image/png'; then
  forward_key
  exit
fi

local_file=$(mktemp --suffix=.png) || exit 1
remote_file=
cleanup() { rm -f -- "$local_file"; }
trap cleanup EXIT

if ! wl-paste --type image/png > "$local_file" || [[ ! -s $local_file ]]; then
  tmux display-message 'Could not read clipboard image'
  exit 1
fi

remote_file=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" 'umask 077; mktemp /tmp/claude-paste.XXXXXXXX.png') || {
  tmux display-message 'Could not create remote image file'
  exit 1
}
if ! scp -q -o BatchMode=yes -o ConnectTimeout=5 "$local_file" "$host:$remote_file"; then
  ssh -o BatchMode=yes "$host" "rm -f -- '$remote_file'" 2>/dev/null || true
  tmux display-message 'Could not transfer clipboard image'
  exit 1
fi

# Claude attaches readable image paths entered as ordinary keystrokes;
# bracketed paste treats the path as literal text instead.
tmux send-keys -l -t "$pane" -- "$remote_file"
