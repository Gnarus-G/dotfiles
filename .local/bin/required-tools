#!/usr/bin/env bash
set -euo pipefail

# Required workstation bootstrap for this dotfiles repo.
# Assumes Arch Linux and Wayland/Hyprland as the default desktop.
# Safe to rerun: pacman uses --needed, git installs skip existing directories.

section() {
  printf '\n\033[1;36m==> %s\033[0m\n' "$1"
}

have() {
  command -v "$1" >/dev/null 2>&1
}

pacman_install() {
  sudo pacman -S --needed "$@"
}

clone_if_missing() {
  local url=$1 target=$2
  if [[ -d $target ]]; then
    echo "ok: $target"
  else
    git clone "$url" "$target"
  fi
}

section "Core command-line tools"
pacman_install \
  base-devel curl fd fzf git jq unzip wget uv

section "Wayland desktop"
pacman_install \
  hyprland hyprpaper hyprlock hyprpolkitagent waybar rofi dunst \
  grim slurp wl-clipboard brightnessctl xdg-desktop-portal-hyprland \
  xdg-desktop-portal-gtk pipewire wireplumber qt5-wayland qt6-wayland

section "Some fonts"
pacman_install \
  ttf-firacode-nerd noto-fonts-emoji noto-fonts-cjk noto-fonts-extra
# getfonts.sh adds Atkinson Hyperlegible Mono and extra Nerd Fonts used by the
# fontconfig and GTK settings in this repo; skip it once Atkinson is present.
if compgen -G "$HOME/.local/share/fonts/AtkinsonHyperlegibleMono/*.ttf" >/dev/null; then
  echo "ok: Atkinson Hyperlegible Mono"
elif have getfonts.sh; then
  getfonts.sh
else
  "$(dirname "$0")/getfonts.sh"
fi

section "Oh My Zsh"
if [[ -d ${ZSH:-$HOME/.oh-my-zsh} ]]; then
  echo "ok: ${ZSH:-$HOME/.oh-my-zsh}"
else
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

zsh_custom=${ZSH_CUSTOM:-${ZSH:-$HOME/.oh-my-zsh}/custom}
clone_if_missing https://github.com/zsh-users/zsh-autosuggestions "$zsh_custom/plugins/zsh-autosuggestions"
clone_if_missing https://github.com/zsh-users/zsh-syntax-highlighting.git "$zsh_custom/plugins/zsh-syntax-highlighting"

section "Tmux"
clone_if_missing https://github.com/gpakosz/.tmux.git "$HOME/.tmux"
ln -s -f "$HOME/.tmux/.tmux.conf" "$HOME/.tmux.conf"

section "x-cmd"
if have x; then
  echo "ok: x-cmd"
else
  eval "$(curl -fsSL https://get.x-cmd.com)"
fi

section "oterm"
uv tool install oterm

section "Dotfiles"
echo "Run ./dev from the dotfiles repo, then log out and select Hyprland if needed."
