{
  "permissions": {
    "defaultMode": "auto"
  },
  "editorMode": "vim",
  "outputStyle": "Evidence First",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/output-style.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "tui": "fullscreen"
}
